{
  "name": "modeling-studio-desktop",
  "version": "1.0.5",
  "description": "Electron desktop packaging for Modeling & Simulation Studio",
  "main": "main.js",
  "scripts": {
    "start":     "electron .",
    "dev":       "electron . --dev",
    "build:web": "cd modeling-studio && npm install && npm run build",
    "build:server-deps": "cd server-deps && npm install --omit=dev",
    "dist":      "npm run build:web && npm run build:server-deps && electron-builder",
    "dist:win":  "npm run build:web && npm run build:server-deps && electron-builder --win --config.win.target=portable",
    "dist:mac":  "npm run build:web && npm run build:server-deps && electron-builder --mac",
    "dist:linux":"npm run build:web && npm run build:server-deps && electron-builder --linux"
  },
  "build": {
    "appId": "fr.modeling-studio.desktop",
    "productName": "Modeling & Simulation Studio",
    "directories": { "output": "dist-electron" },
    "asar": false,
    "extraResources": [
      { "from": "modeling-studio/dist", "to": "web" },
      { "from": "modeling-studio/models", "to": "models", "filter": ["**/*"] },
      { "from": "modeling-studio/server", "to": "server" },
      { "from": "modeling-studio/package.json", "to": "package.json" },
      { "from": "server-deps/node_modules", "to": "node_modules", "filter": ["**/*"] },
      { "from": "modeling-studio/src/uuid.js", "to": "src/uuid.js" },
      { "from": "modeling-studio/src/bpmn-modeler", "to": "src/bpmn-modeler", "filter": ["**/*"] }
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "signingHashAlgorithms": null,
      "sign": null
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "keywords": ["modeling", "simulation", "GRAI", "BPMN", "DEVS", "Actigram"],
  "author": "niko63",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  }
}
